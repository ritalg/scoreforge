# Core
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-256-bit-hex-secret
DATABASE_PATH=./data/sat_prep.db
APP_URL=https://scoreforge.coach   # prod — use http://localhost:5173 for dev

# Superadmin seed (used by db:seed script)
SUPERADMIN_EMAIL=admin@scoreforge.coach
SUPERADMIN_PASSWORD=Admin123!

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Email (choose one)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=app-password
# OR:
# RESEND_API_KEY=re_...

# Redis
REDIS_URL=redis://localhost:6379

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ML microservice
ML_SERVICE_URL=http://localhost:8000

# Search
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Monitoring (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Client
VITE_API_BASE_URL=http://localhost:3001
VITE_VAPID_PUBLIC_KEY=
