# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-at-least-32-random-characters
DATABASE_PATH=../data/scoreforge.db

# ── AI (optional) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Email (optional — dev uses jsonTransport without SMTP_HOST) ───────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM=ScoreForge <noreply@scoreforge.coach>
APP_URL=http://localhost:5173

# ── ML microservice (optional — falls back to in-process linear regression) ───
ML_SERVICE_URL=http://localhost:8000

# ── MeiliSearch (optional — falls back to SQLite LIKE) ────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Seed credentials (used by npm run seed) ───────────────────────────────────
SUPERADMIN_EMAIL=admin@scoreforge.coach
SUPERADMIN_PASSWORD=Admin123!

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOW_PUBLIC_METRICS=false
