NODE_ENV=production
PORT=3001

# Database (Supabase PostgreSQL — replace with your connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Keep this for SQLite fallback during migration
# DATABASE_PATH=/app/data/scoreforge.db

# App
APP_URL=https://scoreforge.coach
SESSION_SECRET=<generate: openssl rand -hex 64>

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-...

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scoreforge.coach

# Redis (Upstash)
REDIS_URL=redis://default:[PASSWORD]@[HOST].upstash.io:6379

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@scoreforge.coach

# File storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scoreforge-uploads
R2_PUBLIC_URL=https://uploads.scoreforge.coach

# Monitoring
SENTRY_DSN=

# ML service (optional — leave blank to use built-in fallback)
ML_SERVICE_URL=
